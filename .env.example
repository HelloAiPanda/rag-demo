# 复制成 .env 后按需填写；不填也能跑（会走本地 hashing 向量 + 原文摘录）
# 注意：本项目不自动加载 .env，请用环境变量注入，或用 `uvicorn --env-file .env`

# ---- 切片与检索 ----
CHUNK_SIZE=350
CHUNK_OVERLAP=80
TOP_K=4
MIN_COVERAGE=0.2

# ---- 向量 ----
# hash：本地零依赖（默认）；remote：走 OpenAI 兼容的 /embeddings
EMBED_MODE=hash
EMBED_DIM=512
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=sk-xxx
# EMBED_MODEL=text-embedding-3-small

# ---- 大模型（不配置则降级为原文摘录）----
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
